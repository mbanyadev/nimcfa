# --- Nimiq ---
NIM_NETWORK=testnet
# NIM_RPC_URL=https://rpc.testnet.nimiqwatch.com/
# Hex private key of the escrow/treasury wallet. Generated by `npm run init:treasury`. NEVER commit.
TREASURY_PRIVATE_KEY=
MIN_CONFIRMATIONS=2

# --- Mobile money: simulator | fapshi | campay ---
PAYOUT_PROVIDER=simulator
# Fapshi: sandbox https://sandbox.fapshi.com, live https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_PAYOUT_APIUSER=
FAPSHI_PAYOUT_APIKEY=
FAPSHI_COLLECT_APIUSER=
FAPSHI_COLLECT_APIKEY=
# CamPay: demo https://demo.campay.net/api, live https://app.campay.net/api
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_TOKEN=

# --- Business rules ---
OFFRAMP_FEE_BPS=150
ONRAMP_FEE_BPS=200
QUOTE_TTL_SECONDS=600
MIN_XAF=100
MAX_XAF=500000
# FIXED_XAF_PER_NIM=0.17

PORT=8787
ALLOWED_ORIGINS=*
DATA_FILE=./data/orders.json

# Browser preview only (testnet): lets the app run outside Nimiq Pay with a server-held test wallet.
ENABLE_DEV_WALLET=false
DEV_WALLET_PRIVATE_KEY=
